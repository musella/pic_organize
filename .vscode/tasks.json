{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lint with flake8",
            "type": "shell",
            "command": "poetry run flake8 src tests",
            "group": "test",
            "problemMatcher": ["$flake8"]
        },
        {
            "label": "Format with black",
            "type": "shell",
            "command": "poetry run black src tests",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
